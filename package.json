{
  "name": "opencode-openspec-sidepanel",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenSpec stats sidebar plugin for OpenCode v2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speclib/opencode-openspec-sidepanel.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openspec"
  ],
  "exports": {
    ".": "./.opencode/plugins/openspec-stats/index.ts",
    "./tui": "./.opencode/plugins/openspec-stats/tui.tsx"
  },
  "files": [
    ".opencode/plugins/openspec-stats"
  ],
  "publishConfig": {
