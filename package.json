  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --test \"e2e/**/*.test.ts\"",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.31"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^24",
    "solid-js": "1.9.12",
    "typescript": "^5"
  }
}
